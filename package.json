{
  "name": "unified-cdn-api",
  "version": "1.3.2",
  "description": "API client for UnifiedCDN.",
  "keywords": [
    "cdn",
    "api",
    "client",
    "typescript",
    "upload",
    "files"
  ],
  "license": "ISC",
  "author": "ng-qi-an",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./classes": {
      "types": "./dist/classes.d.ts",
      "default": "./dist/classes.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./handlers/nextjs": {
      "types": "./dist/methods/handlers/nextjs.d.ts",
      "default": "./dist/methods/handlers/nextjs.js"
    },
    "./handlers": {
      "types": "./dist/methods/handlers/handlers.d.ts",
      "default": "./dist/methods/handlers/handlers.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./helpers": {
      "types": "./dist/helpers/helpers.d.ts",
      "default": "./dist/helpers/helpers.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch --preserveWatchOutput"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
